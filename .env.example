# Copy to .env and adjust. All values are optional.

# Host ports
PANEL_PORT=8020
RTSP_PORT=8556
HLS_PORT=8890

# Protect the web panel with HTTP Basic auth (leave empty to disable)
PANEL_USER=test_user
PANEL_PASSWORD=test_password

# Upload size limit in MB
MAX_UPLOAD_MB=4096

# How many uploads to convert at the same time
TRANSCODE_CONCURRENCY=1
