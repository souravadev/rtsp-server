# Copy to .env and adjust. All values are optional.

# Host ports
PANEL_PORT=8020
RTSP_PORT=8556
HLS_PORT=8890
WEBRTC_PORT=8891

# Comma-separated IPs/hostnames that browsers use to reach this machine for
# WebRTC media (UDP/TCP 8190). Add your LAN IP or public hostname here, or
# previews only work from a browser on this same machine.
WEBRTC_HOSTS=127.0.0.1

# Protect the web panel with HTTP Basic auth (leave empty to disable)
PANEL_USER=test_user
PANEL_PASSWORD=test_password

# Upload size limit in MB
MAX_UPLOAD_MB=4096

# How many uploads to convert at the same time
TRANSCODE_CONCURRENCY=1
